<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <AssemblyName>ViewsIO.IntegrationTests</AssemblyName>
    <RootNamespace>ViewsIO.IntegrationTests</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit"            Version="4.3.2" />
    <PackageReference Include="NUnitLite"        Version="4.3.2" />
    <PackageReference Include="ExtentReports"    Version="5.0.4" />
    <!-- ExtentReports pulls RazorEngine.NetCore.nixFix -> System.Drawing.Common 5.0.0,   -->
    <!-- flagged by NU1904 (GHSA-rxg9-xrhp-64gj). Pin to a patched version explicitly.     -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <!-- AcCoreMgd only — AcMgd.dll crashes accoreconsole with 0xC0000005 -->
    <PackageReference Include="AutoCAD.NET.Core" Version="26.0.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ViewsIO.csproj" />
  </ItemGroup>
</Project>
