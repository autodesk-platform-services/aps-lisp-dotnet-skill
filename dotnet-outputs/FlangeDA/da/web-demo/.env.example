# Copy to .env in this folder (web-demo/.env), or rely on the fallback to the
# project-root D:\Temp\flange\.env if you already have credentials there —
# index.js loads both, da/web-demo/.env taking priority.

APS_CLIENT_ID=
APS_CLIENT_SECRET=

# Required. Not auto-resolved — see index.js's comment on why the flaky
# GET/PATCH forgeapps/me nickname dance from APS-Common.ps1 isn't reimplemented
# here. Use the nickname you already registered (e.g. madcad).
APS_OWNER=

# Optional.
APS_ALIAS=dev
PORT=3000
