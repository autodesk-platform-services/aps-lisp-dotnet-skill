<?xml version="1.0" encoding="utf-8" ?>
<ApplicationPackage SchemaVersion="1.0"
  AutodeskProduct="AutoCAD"
  ProductType="Application"
  AppVersion="1.0.0"
  ProductCode="{00000000-0000-0000-0000-000000000000}"
  Name="HatchBDA"
  Description="HatchBDA AutoCAD Plugin"
  Author="Your Name">
  <CompanyDetails Name="Your Company" Url="https://yourcompany.com" Email="support@yourcompany.com" />
  <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R26.0" SeriesMax="R26.0" />
  <Components Description="HatchBDA">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R26.0" SeriesMax="R26.0" SupportPath="./Contents/Win64" />
    <ComponentEntry
      AppName="HatchBDA"
      AppType=".NET"
      Version="1.0.0"
      ModuleName="./Contents/Win64/HatchBDA.dll"
      LoadOnAutoCADStartup="True">
      <Commands GroupName="HatchBDA_Commands">
        <!-- One <Command> per [CommandMethod] in Commands.cs, matching the original
             LISP's drop-in command names: (defun c:hb ...) (defun c:hbl ...) (defun c:hatchb ...) -->
        <Command Local="HB" Global="HB" />
        <Command Local="HBL" Global="HBL" />
        <Command Local="HATCHB" Global="HATCHB" />
      </Commands>
    </ComponentEntry>
  </Components>
</ApplicationPackage>
