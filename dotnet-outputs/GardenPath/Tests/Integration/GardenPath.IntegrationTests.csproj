<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <AssemblyName>GardenPath.IntegrationTests</AssemblyName>
    <RootNamespace>GardenPath.IntegrationTests</RootNamespace>
    <!-- Force NUnit/NUnitLite DLLs into the output folder.                -->
    <!-- Library projects skip this by default; NETLOAD needs them on disk. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit"               Version="4.3.2" />
    <PackageReference Include="NUnitLite"           Version="4.3.2" />
    <PackageReference Include="ExtentReports"       Version="5.0.4" />
    <!-- ExtentReports pulls RazorEngine.NetCore.nixFix -> System.Drawing.Common 5.0.0,   -->
    <!-- flagged by NU1904 (GHSA-rxg9-xrhp-64gj). Pin to a patched version explicitly.     -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <!-- AcCoreMgd.dll = Database + Geometry + Runtime + Editor (WriteMessage) — works headless.  -->
    <!-- AcMgd.dll    = desktop UI layer (MDI, WPF, palettes, interactive prompts) — crashes accoreconsole. -->
    <!-- AutoCAD.NET.Core omits AcMgd.dll; AutoCAD.NET includes it. Use Core for accoreconsole tests.    -->
    <PackageReference Include="AutoCAD.NET.Core"    Version="26.0.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\GardenPath.csproj" />
  </ItemGroup>
</Project>
